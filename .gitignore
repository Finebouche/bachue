# Datasets: all in bachue/datasets/datasets, downloaded at their first use (the audio of marron1 from Zenodo, those of
# hag) or copied by hand (the corrected annotations of marron1, not published yet), and the MFCC caches
/bachue/datasets/datasets/

# outputs/<study>/{hpo,performances,analysis}: the databases of the datasets (hpo/<dataset>_db.sqlite3) and the
# result CSVs are tracked, not the parts
# of the jobs (merged into the databases: bachue.hpo.studies) nor those of the evaluations
/outputs/*/hpo/parts/
# (the databases of canopy, one per study, copied from PlaFRIM on 2026-11-19: imported into the databases above)
/outputs/_canopy_studies/
/outputs/*/performances/*_parts/
# (outputs/hag_benchmarks: the result CSVs of bachue.performances.hag_benchmarks_evaluation are tracked)

# Slurm logs and task lists of the jobs
/slurm/logs/
/slurm/tasks/
